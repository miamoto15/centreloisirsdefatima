{
  "name": "centreloisirsdefatima",
  "version": "1.0.0",
  "description": "Site web statique vitrine pour le Centre des loisirs de Fatima, un OBNL dedié à la promotion d'événements récréatifs et communautaires dans le village de Fatima.",
  "private": true,
  "scripts": {
    "build": "hugo --environment=production",
    "build:staging": "hugo --environment=staging",
    "start": "hugo serve --logLevel info --configDir=config --buildDrafts --buildFuture --disableFastRender --gc --printI18nWarnings --printUnusedTemplates --templateMetrics",
    "dev": "npm run start",
    "deploy": "npm run build && npx gh-pages -d public"
  },
  "keywords": [
    "loisirs",
    "fatima",
    "evenements",
    "site statique",
    "OBNL",
    "Iles-de-la-Madeleine"
  ],
  "author": "info@centreloisirsfatima.com",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/miamoto15/centreloisirsdefatima"
  },
  "bugs": {
    "url": "https://github.com/miamoto15/centreloisirsdefatima/issues"
  },
  "homepage": "https://centreloisirsfatima.com",
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.6.2"
  }
}
